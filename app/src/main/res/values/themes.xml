<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="Theme.MovieApp" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="colorPrimaryVariant">@color/colorPrimaryVariant</item>
        <item name="colorOnPrimary">@color/colorOnPrimary</item>
        <item name="android:windowBackground">@color/screen_bg</item>
        <item name="android:statusBarColor">@color/splash_bg</item>
        <item name="android:navigationBarColor">@color/screen_bg</item>
    </style>

    <!-- Splash Theme (no flicker) -->
    <style name="Theme.MovieApp.Splash" parent="Theme.MovieApp">
        <item name="android:windowBackground">@color/splash_bg</item>
    </style>

    <!-- Toolbar Title Style -->
    <style name="ToolbarTitleStyle" parent="TextAppearance.MaterialComponents.Headline6">
        <item name="android:fontFamily">@font/poppins_semibold</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textSize">18sp</item>
    </style>

    <!-- Rounded corner shape -->
    <style name="RoundedCorner8" parent="">
        <item name="cornerRadius">8dp</item>
    </style>

</resources>